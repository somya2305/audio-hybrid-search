# Postgres (matches docker-compose.yml; change DB_PORT if 5432 is already in use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=audio_search
DB_USER=rag_user
DB_PASSWORD=rag_password

# Hugging Face token, needed ONLY to transcribe/diarize audio
# (python -m src.pipeline or src.diarization.diarize); indexing and search work without it.
# 1. Accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1
# 2. Create a read token at https://huggingface.co/settings/tokens and paste it here.
HF_TOKEN=
